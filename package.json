{
  "name": "mxdeck",
  "productName": "mxdeck",
  "version": "0.6.0",
  "private": true,
  "description": "A desktop shell for macOS and Windows that keeps several Matrix accounts (Element Web, Cinny, …) side by side in one window",
  "keywords": [
    "matrix",
    "element",
    "cinny",
    "multi-account",
    "electron"
  ],
  "license": "MIT",
  "author": "knagato (https://github.com/knagato)",
  "homepage": "https://github.com/knagato/mxdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knagato/mxdeck.git"
  },
  "bugs": {
    "url": "https://github.com/knagato/mxdeck/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/github.test.mjs tests/site-icon.test.mjs && node tests/plugins.test.mjs",
    "dist": "electron-builder --mac dir --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "dist:win": "electron-builder --win nsis --x64 --arm64 --publish never",
    "install-app": "pnpm run dist && ditto \"dist/mac-arm64/mxdeck.app\" \"$HOME/Applications/mxdeck.app\"",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.knatrix.mxdeck",
    "productName": "mxdeck",
    "copyright": "Copyright © 2026 knagato",
    "files": [
      "src/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "mxdeck uses the microphone for Matrix calls.",
        "NSCameraUsageDescription": "mxdeck uses the camera for Matrix calls."
      },
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}-win-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
